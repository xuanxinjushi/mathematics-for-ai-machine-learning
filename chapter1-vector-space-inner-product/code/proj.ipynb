   "source": [
    "v=np.array([[1,2,3]]).T\n",
    "x=np.array([[2,3,1]]).T\n",
    "n=np.dot(x,x.T)\n",
    "d=np.dot(x.T,x)\n",
    "n, d"
   ]
  },
